# Reference: <https://postmarketos.org/devicepkg>
maintainer="Viktor Zaritskyi <viktorzarickiy@gmail.com>"
pkgname=device-samsung-gta4xlve
pkgver=1
pkgrel=0
pkgdesc="Samsung Galaxy Tab S6 Lite (2022)"
url="https://postmarketos.org"
arch="aarch64"
license="MIT"
depends="
        android-tools-mkbootimg
	firmware-samsung-gta4xlve
	hexagonrpcd>=0.3.2-r3
	linux-firmware-qcom
	linux-postmarketos-qcom-sm7125
	make-dynpart-mappings
	postmarketos-base
	soc-qcom-sm7125
	soc-qcom-sm7125-ucm
	swclock-offset
	systemd-boot
"
makedepends="devicepkg-dev"
install="
	$pkgname-openrc.post-install
	$pkgname-openrc.post-upgrade
"
subpackages="
	$pkgname-openrc
	$pkgname-udev
"
source="
	81-libssc-samsung-gta4xlve.rules
	deviceinfo
	hexagonrpcd-adsp-sensorspd.conf
	kernel-cmdline.conf
	modules-initfs
"
options="!archcheck !check"

build() {
	devicepkg_build $startdir $pkgname
}

package() {
	devicepkg_package $startdir $pkgname

	install -Dm644 "$srcdir"/81-libssc-samsung-gta4xlve.rules \
		-t "$pkgdir"/usr/lib/udev/rules.d/
	install -Dm644 "$srcdir"/hexagonrpcd-adsp-sensorspd.conf \
		-t "$pkgdir"/usr/share/hexagonrpcd/
}

openrc() {
	default_openrc
	depends="hexagonrpcd-openrc"

	mkdir -p "$subpkgdir"
}
