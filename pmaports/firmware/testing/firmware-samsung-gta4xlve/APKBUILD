# Reference: <https://postmarketos.org/devicepkg>
maintainer="Viktor Zaritskyi <viktorzarickiy@gmail.com>"
pkgname=firmware-samsung-gta4xlve
pkgver=1
pkgrel=0
pkgdesc="Firmware for Samsung Galaxy Tab S6 Lite (2022)"
url="https://postmarketos.org"
arch="aarch64"
license="proprietary"
depends="linux-firmware-ath10k linux-firmware-qcom"
source="gta4xlve-firmware.tar.gz
	30-initramfs-firmware.files
	firmware.files
"
options="
	!archcheck
	!check
	!strip
	!tracedeps
	pmb:cross-native
	textrels
"
builddir="$srcdir"

package() {
	local _i
	while IFS="" read -r _i || [ -n "$_i" ]; do
		install -Dm644 "$builddir"/"$_i" "$pkgdir"/"$_i"
	done < "$srcdir"/firmware.files

	install -Dm644 "$srcdir"/30-initramfs-firmware.files \
		-t "$pkgdir"/usr/share/mkinitfs/files
}
