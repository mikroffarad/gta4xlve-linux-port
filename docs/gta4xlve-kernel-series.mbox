+{
+	int error;
+
+	if (IS_ENABLED(CONFIG_I2C)) {
+		error = i2c_add_driver(&himax_i2c_driver);
+		if (error)
+			return error;
+	}
+
+	if (IS_ENABLED(CONFIG_SPI)) {
+		error = spi_register_driver(&himax_spi_driver);
+		if (error) {
+			if (IS_ENABLED(CONFIG_I2C))
+				i2c_del_driver(&himax_i2c_driver);
+			return error;
+		}
+	}
+
+	return 0;
+}
