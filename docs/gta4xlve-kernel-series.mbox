From d9fc14ecf17cbb521faf210807dcfd2952cdeb52 Mon Sep 17 00:00:00 2001
From: Viktor Zaritskyi <viktorzarickiy@gmail.com>
Date: Mon, 7 Sep 2026 21:46:52 +0300
Subject: [PATCH 7/8] Bluetooth: hci_qca: fix a memdump use-after-free, and
 keep WCN3991 awake

Four fixes, all found on a WCN3991 attached over UART on SM7125.

qca_controller_memdump() cached qca->qca_memdump once, before its loop.
Completing a dump frees that buffer and clears the pointer, but the
stale copy stayed behind and was written through on the next iteration
-- which happens whenever the next dump's packets are already queued, as
they are when the controller crashes repeatedly. Re-read it every pass
and clear the pointer on the two error paths that free it.

qca_setup() never reset the IBS state machine, so a re-setup after a
controller crash started from whatever state the previous instance had
left behind.

This controller never answers a wake-up once the host has slept it: every
boot died with ibs_sent_sleeps=1 and Bluetooth then cycled on and off
forever. Add an ibs_host_sleep module parameter to keep it awake, rather
than assuming every QCA part recovers from host-initiated sleep.

Finally, it sets the extended advertising bit in its LE features but then
answers LE_READ_NUM_SUPPORTED_ADV_SETS with Command Disallowed, which
aborts initialisation. Add HCI_QUIRK_BROKEN_EXT_ADV for that, gate
ext_adv_capable() on it, and set it along with the existing broken
extended scan and create-connection quirks for wcn399x.

Signed-off-by: Viktor Zaritskyi <viktorzarickiy@gmail.com>
Co-Authored-By: Claude Opus 5 (1M context) <noreply@anthropic.com>
---
 drivers/bluetooth/hci_qca.c      | 89 ++++++++++++++++++++++++++++++--
 include/net/bluetooth/hci.h      | 12 +++++
 include/net/bluetooth/hci_core.h |  3 +-
 3 files changed, 100 insertions(+), 4 deletions(-)

diff --git a/drivers/bluetooth/hci_qca.c b/drivers/bluetooth/hci_qca.c
index f2558506a..bd70f7261 100644
--- a/drivers/bluetooth/hci_qca.c
+++ b/drivers/bluetooth/hci_qca.c
@@ -239,6 +239,13 @@ static int qca_power_off(struct hci_dev *hdev);
 static void qca_controller_memdump(struct work_struct *work);
 static void qca_dmp_hdr(struct hci_dev *hdev, struct sk_buff *skb);
 
+static bool ibs_host_sleep = true;
+module_param(ibs_host_sleep, bool, 0644);
+MODULE_PARM_DESC(ibs_host_sleep,
+		 "Allow the host to put the controller to sleep over IBS (default true). "
+		 "On boards whose controller never answers the wake-up that follows, "
+		 "clear this to keep it awake instead.");
+
 static enum qca_btsoc_type qca_soc_type(struct hci_uart *hu)
 {
 	enum qca_btsoc_type soc_type;
@@ -483,6 +490,11 @@ static void hci_ibs_tx_idle_timeout(struct timer_list *t)
 	spin_lock_irqsave_nested(&qca->hci_ibs_lock,
 				 flags, SINGLE_DEPTH_NESTING);
 
+	if (!ibs_host_sleep) {
+		spin_unlock_irqrestore(&qca->hci_ibs_lock, flags);
+		return;
+	}
+
 	switch (qca->tx_ibs_state) {
 	case HCI_IBS_TX_AWAKE:
 		/* TX_IDLE, go to SLEEP */
@@ -1035,7 +1047,7 @@ static void qca_controller_memdump(struct work_struct *work)
 	struct hci_uart *hu = qca->hu;
 	struct sk_buff *skb;
 	struct qca_memdump_event_hdr *cmd_hdr;
-	struct qca_memdump_info *qca_memdump = qca->qca_memdump;
+	struct qca_memdump_info *qca_memdump;
 	struct qca_dump_size *dump;
 	u16 seq_no;
 	u32 rx_size;
@@ -1045,6 +1057,16 @@ static void qca_controller_memdump(struct work_struct *work)
 	while ((skb = skb_dequeue(&qca->rx_memdump_q))) {
 
 		mutex_lock(&qca->hci_memdump_lock);
+
+		/* Re-read this on every iteration. Completing a dump frees
+		 * the buffer and clears qca->qca_memdump, but a cached copy
+		 * would stay behind and be written through on the next pass,
+		 * which happens whenever the packets of the following dump
+		 * are already queued -- as they are when the controller
+		 * crashes repeatedly.
+		 */
+		qca_memdump = qca->qca_memdump;
+
 		/* Skip processing the received packets if timeout detected
 		 * or memdump collection completed.
 		 */
@@ -1084,6 +1106,7 @@ static void qca_controller_memdump(struct work_struct *work)
 			if (!(qca_memdump->ram_dump_size)) {
 				bt_dev_err(hu->hdev, "Rx invalid memdump size");
 				kfree(qca_memdump);
+				qca->qca_memdump = NULL;
 				kfree_skb(skb);
 				mutex_unlock(&qca->hci_memdump_lock);
 				return;
@@ -1120,6 +1143,7 @@ static void qca_controller_memdump(struct work_struct *work)
 		if (!test_bit(QCA_MEMDUMP_COLLECTION, &qca->flags)) {
 			bt_dev_err(hu->hdev, "QCA: Discarding other packets");
 			kfree(qca_memdump);
+			qca->qca_memdump = NULL;
 			kfree_skb(skb);
 			mutex_unlock(&qca->hci_memdump_lock);
 			return;
@@ -1880,6 +1904,7 @@ static int qca_setup(struct hci_uart *hu)
 	struct qca_btsoc_version ver;
 	struct qca_serdev *qcadev;
 	const char *soc_name;
+	unsigned long ibs_flags;
 
 	ret = qca_check_speeds(hu);
 	if (ret)
@@ -1905,6 +1930,26 @@ static int qca_setup(struct hci_uart *hu)
 	case QCA_WCN3991:
 	case QCA_WCN3998:
 		soc_name = "wcn399x";
+		/*
+		 * These claim extended advertising in their LE features but
+		 * answer HCI_OP_LE_READ_NUM_SUPPORTED_ADV_SETS with Command
+		 * Disallowed, which aborts initialisation and leaves the
+		 * controller down. They likewise claim the extended scanning
+		 * commands and then never answer LE Set Extended Scan
+		 * Parameters at all, so discovery times out.
+		 */
+		set_bit(HCI_QUIRK_BROKEN_EXT_ADV, &hdev->quirks);
+		set_bit(HCI_QUIRK_BROKEN_EXT_SCAN, &hdev->quirks);
+		/*
+		 * They advertise LE Extended Create Connection in their
+		 * supported commands as well, and answer it with Command
+		 * Disallowed, so no LE connection is ever established: every
+		 * attempt comes back as MGMT_STATUS_BUSY once the 0x0c reply
