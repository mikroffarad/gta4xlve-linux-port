+	error = PTR_ERR_OR_ZERO(regmap);
+	if (error) {
+		dev_err(dev, "Failed to initialize regmap: %d\n", error);
+		return error;
+	}
+
+	return himax_probe(dev, regmap, spi->irq,
+			   spi_get_device_match_data(spi), dev_name(dev));
