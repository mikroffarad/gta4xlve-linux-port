+{
+	if (IS_ENABLED(CONFIG_SPI))
+		spi_unregister_driver(&himax_spi_driver);
+	if (IS_ENABLED(CONFIG_I2C))
+		i2c_del_driver(&himax_i2c_driver);
+}
+module_exit(himax_ts_exit);
 
